# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Optional PostgreSQL connection URL.
# You can get a 100% FREE PostgreSQL database from:
# 1. Neon (https://neon.tech) - Free serverless PostgreSQL, instant setup
# 2. Render (https://render.com) - Free PostgreSQL service
# 3. Supabase (https://supabase.com) - Free PostgreSQL database
# Example:
# DATABASE_URL="postgres://username:password@ep-cool-star-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""
